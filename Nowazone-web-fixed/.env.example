# Copy to .env and fill in. Only VITE_-prefixed vars are exposed to the browser.
# Client IDs are public; never put client secrets here.

# API origin. Leave empty to use the same origin (Vite dev proxy / reverse proxy).
VITE_API_BASE_URL=

# Social sign-in client IDs (from each provider's developer console).
VITE_GOOGLE_CLIENT_ID=
VITE_LINKEDIN_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=

# Optional: pin the OAuth redirect_uri to the exact value registered in the
# provider console. Required when the app is served from a different origin than
# the one registered (e.g. www vs non-www, 127.0.0.1 vs localhost, a different
# port, or a reverse proxy). When omitted the app falls back to
# `${window.location.origin}/portal`.
# Example: https://www.nowazone.com/portal
VITE_LINKEDIN_REDIRECT_URI=
VITE_GITHUB_REDIRECT_URI=
