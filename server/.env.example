NODE_ENV=development
# Example port avoids the unrelated service observed on port 5000.
PORT=5001
# Use a dedicated test database first. Transactions require MongoDB Atlas or a replica set.
MONGODB_URI=
JWT_ACCESS_SECRET=
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional acknowledgements and estimator emails; no email is claimed without delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Required for PDF resume uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Rate Limiting Configuration ─────────────────────────────────────────────
# Adjust these values based on your expected traffic and abuse prevention needs.
# Higher values = more permissive, Lower values = stricter security

# General API rate limit (applies to all /api routes)
# Default: 500 requests per 15 minutes (increased from 100)
API_RATE_LIMIT_MAX=500

# Authentication endpoints (login, register)
# Default: 10 attempts per 15 minutes (increased from 5)
AUTH_RATE_LIMIT_MAX=10

# Token refresh endpoint
# Default: 50 requests per 15 minutes (increased from 20)
REFRESH_RATE_LIMIT_MAX=50

# Password reset requests
# Default: 10 requests per hour (increased from 5)
FORGOT_RATE_LIMIT_MAX=10

# Public form submissions (assessment, appointment, download)
# Default: 20 submissions per 15 minutes (increased from 10)
FORM_RATE_LIMIT_MAX=20

# Contact form submissions
# Default: 10 submissions per 15 minutes (increased from 5)
CONTACT_RATE_LIMIT_MAX=10

# Public ticket creation
# Default: 20 tickets per 15 minutes (increased from 10)
TICKET_RATE_LIMIT_MAX=20

# Newsletter subscription
# Default: 10 subscriptions per hour (increased from 5)
SUBSCRIBE_RATE_LIMIT_MAX=10

# Chatbot public endpoint
# Default: 60 messages per minute (increased from 30)
CHATBOT_RATE_LIMIT_MAX=60

# Analytics tracking (page views, events)
# Default: 120 requests per minute (increased from 60)
TRACKING_RATE_LIMIT_MAX=120

# Comment reading (public endpoint)
# Default: 120 requests per 15 minutes (increased from 60)
COMMENT_READ_RATE_LIMIT_MAX=120
